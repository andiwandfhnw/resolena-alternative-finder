+    def open_query_process(self, pid):
+        if type(pid) is not int or not 0 < pid <= 0xFFFFFFFF:
+            raise JobError('explicit valid query-only process identity required')
+        handle = self.k.OpenProcess(0x1000,False,pid)
+        if not handle:
+            raise c.WinError(c.get_last_error())
+        return handle
+
+    def image_path(self, handle):
+        capacity = 32768
+        buffer = c.create_unicode_buffer(capacity)
+        length = DWORD(capacity)
+        self.checked(self.k.QueryFullProcessImageNameW(handle,0,buffer,c.byref(length)),
+                     'QueryFullProcessImageNameW')
+        path = buffer.value
+        units = len(path.encode('utf-16-le', 'surrogatepass')) // 2
+        if not 0 < length.value < capacity or units != length.value:
+            raise JobError('native image path length unavailable or truncated')
+        drive, tail = ntpath.splitdrive(path)
+        if not drive or not tail.startswith(('\\','/')) or not ntpath.basename(path):
+            raise JobError('native full image path unavailable')
+        return path
+
+    def query_exit_code(self, handle):
+        code = DWORD()
+        self.checked(self.k.GetExitCodeProcess(handle,c.byref(code)),
+                     'GetExitCodeProcess query-only observation')
+        return int(code.value)
