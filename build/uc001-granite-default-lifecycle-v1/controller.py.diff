+    def phase_helpers_pending(self, observation):
+        count = observation.get("active_processes")
+        if type(count) is not int or count < 0:
+            raise ControllerFailure("phase_active_processes_unknown")
+        if not self.proxy_helpers:
+            if count:
+                raise ControllerFailure("active_descendants_after_worker_exit")
+        rows = observation.get("owned")
+        if not isinstance(rows, list):
+            raise ControllerFailure("phase_owned_identities_unknown")
+        active, seen = set(), set()
+        for row in rows:
+            if (not isinstance(row, dict) or type(row.get("pid")) is not int
+                    or not 0 < row["pid"] <= 0xFFFFFFFF
+                    or type(row.get("creation_time_100ns")) is not int or row["creation_time_100ns"] <= 0
+                    or "exit_code" not in row
+                    or row["exit_code"] is not None and type(row["exit_code"]) is not int):
+                raise ControllerFailure("phase_owned_identity_invalid")
+            key = row["pid"], row["creation_time_100ns"]
+            if key in seen:
+                raise ControllerFailure("phase_owned_identity_duplicate")
+            seen.add(key)
+            if row["exit_code"] is None:
+                active.add(key)
+        helpers = {(ref["pid"], ref["creation_time_100ns"]): ref for ref in self.proxy_helpers.values()}
+        if len(active) != count or not active <= helpers.keys():
+            raise ControllerFailure("active_descendants_after_worker_exit")
+        api = self.backend.api
+        for key, ref in helpers.items():
+            self.check_deadline()
+            process = self.proxy_helper_processes.get(key)
+            handle = ref.get("handle")
+            if (key not in seen or process is None or handle is None
+                    or self.proxy_queries.get(key[0]) is not ref
+                    or ref.get("accepted_helper") is not True or ref.get("verified") is not True
+                    or ref.get("expected_inside") is not True
+                    or (process.pid, process.creation_time_100ns) != key
+                    or api.process_id(handle) != key[0] or api.creation_time(handle) != key[1]):
+                raise ControllerFailure("phase_helper_retained_identity_unverified")
+            code = self.backend.process_exit(process)
+            raw_code = api.query_exit_code(handle)
+            if type(raw_code) is not int or not 0 <= raw_code <= 0xFFFFFFFF:
+                raise ControllerFailure("phase_helper_exit_unverified")
+            if code is None and raw_code != 259:
+                self.check_deadline()
+                code = self.backend.process_exit(process)
+            if code is None:
+                if (key not in active or raw_code != 259
+                        or api.in_job(handle, self.backend.handle) is not True
+                        or api.parent_pid(handle) != ref["parent_pid"]):
+                    raise ControllerFailure("phase_helper_membership_or_exit_unverified")
+                import ntpath
+                if ntpath.normcase(api.image_path(handle)) != ntpath.normcase(api.system_console_path()):
+                    raise ControllerFailure("phase_helper_path_differs")
+            elif type(code) is not int or not 0 <= code <= 0xFFFFFFFF or raw_code != code:
+                raise ControllerFailure("phase_helper_exit_unverified")
+            if api.process_id(handle) != key[0] or api.creation_time(handle) != key[1]:
+                raise ControllerFailure("phase_helper_retained_identity_changed")
+        return count != 0
 
