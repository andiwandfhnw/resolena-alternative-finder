+@pytest.mark.parametrize('architecture', ['x64', 'amd64'])
+def test_environment_guard_accepts_mixed_case_keys(windows_environment, architecture):
+    aliases = {'VCTOOLSVERSION': 'VCToolsVersion', 'WINDOWSSDKVERSION': 'WindowsSDKVersion',
+               'VSCMD_ARG_HOST_ARCH': 'Vscmd_arg_host_arch', 'VSCMD_ARG_TGT_ARCH': 'vscmd_arg_tgt_arch',
+               'VULKAN_SDK': 'Vulkan_Sdk', 'VK_SDK_PATH': 'Vk_Sdk_Path', 'PATH': 'Path'}
+    env = {aliases.get(key, key): value for key, value in windows_environment.items()}
+    env['Vscmd_arg_host_arch'] = env['vscmd_arg_tgt_arch'] = architecture
+    original = dict(env)
+    result = validate_environment(env, exists=lambda _: True, which=environment_tool)
+    assert result['PATH'] == NINJA.rsplit('\\', 1)[0] + ';' + original['Path']
+    assert result['CMAKE_BUILD_PARALLEL_LEVEL'] == '2'
+    assert result['GIT_LFS_SKIP_SMUDGE'] == '1'
+    assert env == original
