+def test_default_session_reconciles_admitted_helper_exit_between_snapshot_count_and_owned_rows(tmp_path):
+    result, backend = lifecycle_session(tmp_path,'helper_lag','snapshot_helper_exit')
+    assert result['status']=='controlled_phases_passed', result
+    assert backend.timeline.index('snapshot_count_observed:1') < backend.timeline.index('helper_exited_before_owned_rows')
+    assert backend.timeline.index('helper_exited_before_owned_rows') < backend.timeline.index('fresh_consistent_zero_snapshot')
+    assert backend.timeline.index('fresh_consistent_zero_snapshot') < backend.timeline.index('launch:101')
+    assert backend.phase_snapshot_calls>=2
+    assert backend.terminated==0 and backend.direct_terminations==[]
+    assert backend.watchdog.helper_wait_beats>=1
+    assert result['proxy_identity_cleanup'][0]['verified'] is True
+
+
+@pytest.mark.parametrize('damage', ['snapshot_unexplained_count','snapshot_unknown',
+                                  'snapshot_changed_birth','snapshot_missing_owned_row',
+                                  'snapshot_exit_unavailable','snapshot_query_unavailable'])
+def test_default_session_snapshot_reconciliation_rejects_unexplained_or_unverified_state(tmp_path, damage):
+    result, backend = lifecycle_session(tmp_path,'helper_lag',damage)
+    assert result['status']=='failure', result
+    assert backend.snapshot_exit_observed is True
+    assert len(backend.launched)==1 and backend.terminated>=1
+    assert backend.direct_terminations==[]
+
+
+@pytest.mark.parametrize('damage', ['snapshot_never_zero','snapshot_unavailable','snapshot_resurrected'])
+def test_default_session_snapshot_reconciliation_requires_fresh_consistent_zero(tmp_path, damage):
+    result, backend = lifecycle_session(tmp_path,'helper_lag',damage)
+    assert result['status']=='failure', result
+    assert backend.phase_snapshot_calls==2
+    assert 'fresh_consistent_zero_snapshot' not in backend.timeline
+    assert len(backend.launched)==1 and backend.terminated>=1
+    assert backend.direct_terminations==[]
+
+
+def test_default_session_snapshot_exit_credit_requires_prior_retained_active_evidence(tmp_path):
+    result, backend = lifecycle_session(tmp_path,'helper_lag','snapshot_no_admission_active')
+    assert result['status']=='failure', result
+    assert len(backend.launched)==1 and backend.terminated>=1
+    assert backend.direct_terminations==[]
+
+
+@pytest.mark.parametrize('damage', ['snapshot_deadline','snapshot_resource'])
+def test_default_session_snapshot_reconciliation_preserves_deadline_and_resource_checks(tmp_path, damage):
+    result, backend = lifecycle_session(tmp_path,'helper_lag',damage)
+    assert result['status']=='failure', result
+    assert backend.snapshot_exit_observed is True
+    assert 'deadline' in result['reason'] if damage=='snapshot_deadline' else 'disk_floor' in result['reason']
+    assert len(backend.launched)==1 and backend.terminated>=1
+    assert backend.direct_terminations==[]
