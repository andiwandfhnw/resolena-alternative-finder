+    def selftest_worker_identity(self):
+        api=self.native_api()
+        handle=api.open_process(os.getpid())
+        try:
+            identity=self.retained_identity(handle,os.getpid())
+        finally:
+            api.close_handle(handle)
+        return identity
+    def finish_proxy_selftest_handles(self,proxy):
+        if not proxy.closing or not proxy.controller_bound:
+            raise WorkerFailure('selftest_proxy_cleanup_before_planned_close')
+        if self.proxy_states(proxy)!=[0,0] or proxy.process.wait()!=0:
+            raise WorkerFailure('selftest_proxy_cleanup_exit_unverified')
+        proxy.selftest_handle_cleanup_started=True
+        self.close_proxy_handles(proxy)
+        handle=proxy.process._handle
+        handle.Close()
+        if handle.closed is not True:
+            raise WorkerFailure('selftest_proxy_launcher_handle_not_closed')
+        return dict(interpreter_query=proxy.interpreter_handle is None or not proxy.interpreter_opened,
+                    launcher_handle=True,stdout=proxy.stdout_file.closed,stderr=proxy.stderr_file.closed)
