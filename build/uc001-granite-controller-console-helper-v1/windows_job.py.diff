+    def system_console_path(self):
+        capacity = 32768
+        buffer = c.create_unicode_buffer(capacity)
+        length = int(self.k.GetSystemDirectoryW(buffer,capacity))
+        self.checked(length,'GetSystemDirectoryW')
+        directory = buffer.value
+        units = len(directory.encode('utf-16-le','surrogatepass')) // 2
+        drive, tail = ntpath.splitdrive(directory)
+        if (not 0 < length < capacity or units != length or not drive
+                or not tail.startswith('\\') or ntpath.normpath(directory) != directory):
+            raise JobError('native Windows system directory unavailable or truncated')
+        return ntpath.join(directory,'conhost.exe')
